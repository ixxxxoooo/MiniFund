*.syso
build/windows/icon.ico

# DMG / 打包中间产物
*.dmg
dmg-staging/

# ---- 依赖 ----
node_modules/

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志与临时文件 ----
*.log
*.tmp
tmp/

# ---- 编辑器 / IDE ----
.idea/
.vscode/

# ---- 本地调试脚本（请勿提交临时探针脚本）----
.diag.py
.tmp_*.py
probe*.txt
tlog.txt
.test_touch
